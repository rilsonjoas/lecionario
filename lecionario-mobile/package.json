{
  "name": "lecionario-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:android": "eas update --branch preview --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@sentry/react-native": "^8.23.0",
    "date-fns": "^4.4.0",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "private": true,
  "overrides": {
    "react-native": "0.81.5",
    "expo-font": "~14.0.12",
    "brace-expansion": "^5.0.9 || ^2.1.4 || ^1.1.18"
  }
}
